// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`error distribution queries fetches an error distribution 1`] = `
Object {
  "apm": Object {
    "events": Array [
      "error",
    ],
  },
  "filter": Object {
    "bool": Object {
      "filter": Array [
        Object {
          "range": Object {
            "@timestamp": Object {
              "format": "epoch_millis",
              "gte": 0,
              "lte": 50000,
            },
          },
        },
      ],
    },
  },
  "params": Array [
    Object {
      "error_type_value": "crash",
    },
    Object {
      "service_name_value": "serviceName",
    },
    Object {
      "intervalMs": 3333,
    },
  ],
  "query": "FROM myIndex | WHERE \`error.type\` == ?error_type_value | WHERE \`service.name\` == ?service_name_value | EVAL bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?intervalMs | STATS doc_count = COUNT(*) BY bucket | LIMIT 16",
}
`;

