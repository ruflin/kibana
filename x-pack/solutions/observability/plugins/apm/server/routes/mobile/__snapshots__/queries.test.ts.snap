// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`mobile filters queries getDeviceOSApp excludes crash documents when the error type is error 1`] = `
Object {
  "apm": Object {
    "sources": Array [
      Object {
        "documentType": "error",
        "rollupInterval": "none",
      },
    ],
  },
  "filter": Object {
    "bool": Object {
      "filter": Array [
        Object {
          "bool": Object {
            "must_not": Array [
              Object {
                "term": Object {
                  "error.type": "crash",
                },
              },
            ],
          },
        },
        Object {
          "range": Object {
            "@timestamp": Object {
              "format": "epoch_millis",
              "gte": 0,
              "lte": 50000,
            },
          },
        },
      ],
    },
  },
  "params": Array [
    Object {
      "service_name_value": "serviceName",
    },
  ],
  "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`service.name\` == ?service_name_value | WHERE \`device.model.identifier\` IS NOT NULL | STATS doc_count = COUNT(*) BY \`device.model.identifier\` | SORT doc_count DESC, \`device.model.identifier\` ASC | LIMIT 10000",
}
`;

