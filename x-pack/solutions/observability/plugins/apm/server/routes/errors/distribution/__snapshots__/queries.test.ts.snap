  "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`service.name\` == ?serviceName | WHERE \`error.grouping_key\` == ?groupId | STATS doc_count = COUNT(*) BY bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?bucketSize | SORT bucket ASC | LIMIT 10000",
