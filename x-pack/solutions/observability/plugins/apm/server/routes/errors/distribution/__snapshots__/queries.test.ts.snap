// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`error distribution queries fetches an error distribution 1`] = `
Object {
  "apm": Object {
    "sources": Array [
      Object {
        "documentType": "error",
        "rollupInterval": "none",
      },
    ],
  },
  "filter": Object {
    "bool": Object {
      "filter": Array [
        Object {
          "range": Object {
            "@timestamp": Object {
              "format": "epoch_millis",
              "gte": 0,
              "lte": 50000,
            },
          },
        },
        Object {
          "bool": Object {
            "must_not": Object {
              "term": Object {
                "error.type": "crash",
              },
            },
          },
        },
      ],
    },
  },
  "params": Array [
    Object {
      "serviceName": "serviceName",
    },
    Object {
      "bucketSize": 3333,
    },
  ],
  "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`service.name\` == ?serviceName | STATS doc_count = COUNT(*) BY bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?bucketSize | SORT bucket ASC | LIMIT 10000",
}
`;

