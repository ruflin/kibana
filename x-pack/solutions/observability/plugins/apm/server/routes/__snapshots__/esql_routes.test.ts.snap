// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ES|QL reads of the APM routes dependency charts computes the failure rate of every bucket 1`] = `
Array [
  Object {
    "operationName": "get_error_rate_for_dependency",
    "params": Array [
      Object {
        "dependencyName": "postgres",
      },
      Object {
        "spanName": "SELECT",
      },
      Object {
        "success": "success",
      },
      Object {
        "failureOutcome": "failure",
      },
      Object {
        "failure": "failure",
      },
      Object {
        "intervalInMs": 60000,
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`span.destination.service.resource\` == ?dependencyName | WHERE \`span.name\` == ?spanName | WHERE \`event.outcome\` IN (?success, ?failureOutcome) | STATS total_count = SUM(\`span.destination.service.response_time.count\`), failure_count = SUM(\`span.destination.service.response_time.count\`) WHERE \`event.outcome\` == ?failure BY bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?intervalInMs | SORT bucket ASC | LIMIT 10000",
  },
]
`;

exports[`ES|QL reads of the APM routes dependency charts computes the latency of every bucket and leaves the empty ones as NaN 1`] = `
Array [
  Object {
    "operationName": "get_latency_for_dependency",
    "params": Array [
      Object {
        "dependencyName": "postgres",
      },
      Object {
        "spanName": "SELECT",
      },
      Object {
        "intervalInMs": 60000,
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`span.destination.service.resource\` == ?dependencyName | WHERE \`span.name\` == ?spanName | STATS latency_sum = SUM(\`span.destination.service.response_time.sum.us\`), latency_count = SUM(\`span.destination.service.response_time.count\`) BY bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?intervalInMs | SORT bucket ASC | LIMIT 10000",
  },
]
`;

exports[`ES|QL reads of the APM routes dependency charts reads the type and subtype of the latest span of a dependency 1`] = `
Array [
  Object {
    "operationName": "get_metadata_for_dependency",
    "params": Array [
      Object {
        "dependencyName": "postgres",
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`span.destination.service.resource\` == ?dependencyName | SORT @timestamp DESC NULLS LAST | KEEP span.type, span.subtype | LIMIT 1",
  },
]
`;

exports[`ES|QL reads of the APM routes dependency charts turns the counts of a bucket into a rate per minute 1`] = `
Array [
  Object {
    "operationName": "get_throughput_for_dependency",
    "params": Array [
      Object {
        "dependencyName": "postgres",
      },
      Object {
        "spanName": "SELECT",
      },
      Object {
        "intervalInMs": 60000,
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`span.destination.service.resource\` == ?dependencyName | WHERE \`span.name\` == ?spanName | STATS total_count = SUM(\`span.destination.service.response_time.count\`) BY bucket = TO_LONG(@timestamp) - TO_LONG(@timestamp) % ?intervalInMs | SORT bucket ASC | LIMIT 10000",
  },
]
`;

exports[`ES|QL reads of the APM routes infrastructure and profiling fields lists the containers, hosts and pods of a service by number of documents 1`] = `
Array [
  Object {
    "operationName": "get_service_infrastructure",
    "params": Array [
      Object {
        "service_name": "svc",
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`container.id\` IS NOT NULL | WHERE \`service.name\` == ?service_name | STATS doc_count = COUNT(*) BY \`container.id\` | SORT doc_count DESC, \`container.id\` ASC | LIMIT 500",
  },
  Object {
    "operationName": "get_service_infrastructure",
    "params": Array [
      Object {
        "service_name": "svc",
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`host.name\` IS NOT NULL | WHERE \`service.name\` == ?service_name | STATS doc_count = COUNT(*) BY \`host.name\` | SORT doc_count DESC, \`host.name\` ASC | LIMIT 500",
  },
  Object {
    "operationName": "get_service_infrastructure",
    "params": Array [
      Object {
        "service_name": "svc",
      },
    ],
    "query": "SET unmapped_fields = \\"nullify\\"; FROM myIndex | WHERE \`kubernetes.pod.name\` IS NOT NULL | WHERE \`service.name\` == ?service_name | STATS doc_count = COUNT(*) BY \`kubernetes.pod.name\` | SORT doc_count DESC, \`kubernetes.pod.name\` ASC | LIMIT 500",
  },
]
`;

